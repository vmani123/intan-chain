# Defaults for the intan-chain ESP32-S3 node.
#
# Everything here is either required (target) or is a setting that measurably
# moves UDP TX throughput. Anything that does not move the number is left at
# the IDF default so the configuration stays readable.

CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------- CPU / build
# 240 MHz. The send path is CPU bound long before the radio is: at 4000
# datagrams/s the per-datagram cost of memcpy into a pbuf plus the driver
# hand-off dominates, and dropping to 160 MHz costs roughly a third of the
# achievable rate.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Optimise for speed, not size. This is a measurement rig; the flash is empty.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 kHz tick. The synthetic source paces on a 1 ms timer and the sink sleeps
# 1 tick when lwIP runs out of pbufs; at the default 100 Hz that sleep is
# 10 ms and turns a transient buffer shortage into a visible stall.
CONFIG_FREERTOS_HZ=1000

# ------------------------------------------------------------------- task WDT
# Keep the watchdog on -- a wedged sink is exactly the failure this rig has to
# report rather than hide -- but stop it watching the idle tasks. The source
# task owns core 1 at high priority in bursts and the idle task there can be
# starved for longer than the default 5 s without anything being wrong.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---------------------------------------------------------------------- lwIP
# The single most important knob: how many packets can be in flight between
# the sink task and the Wi-Fi driver. Default TCPIP mbox is 32; at 4000 pkt/s
# a 6 ms driver stall overflows it and sendto() starts returning ENOMEM.
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# TCP window/send buffer. This firmware sends UDP only, so these do not touch
# the data path; they are raised anyway so that running iperf's TCP mode on
# the same binary gives a comparable reference number.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534

# lwIP runs on core 0 next to the Wi-Fi task. Keeping them on one core keeps
# the pbuf hand-off out of the cross-core queue; core 1 is left for ingress.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# ---------------------------------------------------------------------- Wi-Fi
# Dynamic TX buffers rather than static: a static TX buffer is a fixed 1.6 kB
# slot, so 32 of them cost 52 kB of always-resident RAM to hold 32 packets.
# Dynamic buffers are sized to the frame and let the same RAM hold more of
# them, which is what absorbs a retransmit burst.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64

# A-MPDU aggregation with a deep block-ack window. Without aggregation a
# 1392-byte datagram pays a full PHY preamble and a SIFS/ACK each, which caps
# 802.11n throughput at roughly a third of the PHY rate.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Put the Wi-Fi hot paths in IRAM. Costs about 15 kB of IRAM, buys the flash
# cache misses that otherwise show up as jitter in the inter-packet gap.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# --------------------------------------------------------------------- misc
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
